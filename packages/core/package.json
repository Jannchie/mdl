{
  "name": "@jannchie/mdl-core",
  "type": "module",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/mdl.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "default": "./src/dev.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  }
}
