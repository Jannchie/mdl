{
  "name": "@jannchie/mdl-sdk",
  "type": "module",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/mdl.git",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "default": "./src/dev.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@jannchie/mdl-core": "workspace:*",
    "migu-music-api": "^1.0.1",
    "netease-cloud-music-api": "^0.1.8",
    "ytdlp-nodejs": "^3.4.4"
  }
}
